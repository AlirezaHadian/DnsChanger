<Window x:Class="DnsChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Changer" Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!--  رنگ‌های اصلی تم  -->
        <SolidColorBrush x:Key="BgDark" Color="#0F1117"/>
        <SolidColorBrush x:Key="BgCard" Color="#1A1D29"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#232739"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F2F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8A8F9E"/>
        <SolidColorBrush x:Key="Success" Color="#22C55E"/>
        <SolidColorBrush x:Key="Danger" Color="#EF4444"/>

        <!--  گرادینت لهجه‌ی نئونی برای دکمه‌ها/هدر  -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5B8CFF" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <!--  استایل کارت DNS  -->
        <Style x:Key="DnsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2E3F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgCardHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  دکمه‌ی اصلی (اعمال DNS)  -->
        <Style x:Key="ApplyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  دکمه‌ی ثانویه (Reset / Flush)  -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="#2A2E3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  استایل ورودی متن (کاستوم DNS)  -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#12141C"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#2A2E3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlue}"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--  هدر  -->
            <RowDefinition Height="Auto"/>
            <!--  نوار وضعیت اتصال  -->
            <RowDefinition Height="Auto"/>
            <!--  عنوان بخش  -->
            <RowDefinition Height="Auto"/>
            <!--  گرید کارت‌های DNS  -->
            <RowDefinition Height="Auto"/>
            <!--  بخش کاستوم DNS  -->
            <RowDefinition Height="*"/>
            <!--  تاریخچه  -->
        </Grid.RowDefinitions>

        <!--  ===================== هدر ===================== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentGradient}">
                <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="DNS Changer" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="تغییر سریع DNS با یک کلیک" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </StackPanel>

        <!--  ===================== نوار وضعیت اتصال فعلی ===================== -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="12" Padding="16,12" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="آداپتور فعال" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="ActiveAdapterText" Text="Wi-Fi" FontSize="14" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="DNS فعلی" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="CurrentDnsText" Text="خودکار (DHCP)" FontSize="14" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="IP عمومی" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="PublicIpText" Text="—" FontSize="14" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="3" Background="#1E293B" CornerRadius="20" Padding="10,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
                        <TextBlock Text="متصل" Foreground="{StaticResource Success}" FontSize="12" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  ===================== عنوان بخش سرورها ===================== -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="سرورهای DNS" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="MessageTextBlock" Grid.Column="1" Visibility="Hidden"
                       FontSize="12" Foreground="{StaticResource Success}" VerticalAlignment="Center"/>
        </Grid>

        <!--  ===================== گرید کارت‌های DNS ===================== -->
        <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,22">

            <!--  کارت Shecan  -->
            <Border Style="{StaticResource DnsCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1E293B" HorizontalAlignment="Left">
                        <TextBlock Text="🛡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Shecan" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,2"/>
                    <TextBlock Text="178.22.122.100" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="185.51.200.2" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                    <Button Content="اعمال" Style="{StaticResource ApplyButtonStyle}" Click="Shecan_Click"/>
                </StackPanel>
            </Border>

            <!--  کارت Bogzar  -->
            <Border Style="{StaticResource DnsCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1E293B" HorizontalAlignment="Left">
                        <TextBlock Text="🌐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Bogzar" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,2"/>
                    <TextBlock Text="185.55.226.26" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="185.55.225.25" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                    <Button Content="اعمال" Style="{StaticResource ApplyButtonStyle}" Click="Bogzar_Click"/>
                </StackPanel>
            </Border>

            <!--  کارت Host Iran  -->
            <Border Style="{StaticResource DnsCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1E293B" HorizontalAlignment="Left">
                        <TextBlock Text="🖥" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Host Iran" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,2"/>
                    <TextBlock Text="172.29.0.100" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="172.29.2.100" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                    <Button Content="اعمال" Style="{StaticResource ApplyButtonStyle}" Click="HostIran_Click"/>
                </StackPanel>
            </Border>

            <!--  کارت 403  -->
            <Border Style="{StaticResource DnsCardStyle}">
                <StackPanel>
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1E293B" HorizontalAlignment="Left">
                        <TextBlock Text="🔓" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="403 Online" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,2"/>
                    <TextBlock Text="10.202.10.202" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="10.202.10.102" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                    <Button Content="اعمال" Style="{StaticResource ApplyButtonStyle}" Click="_403_Click"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!--  ===================== بخش DNS کاستوم ===================== -->
        <Border Grid.Row="4" Style="{StaticResource DnsCardStyle}" Margin="0,0,0,22" Cursor="Arrow">
            <StackPanel>
                <TextBlock Text="افزودن DNS کاستوم" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomNameBox" Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,8,0" Tag="نام (مثلا Gaming DNS)"/>
                    <TextBox x:Name="CustomPrimaryBox" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,0,8,0" Tag="Primary DNS"/>
                    <TextBox x:Name="CustomSecondaryBox" Grid.Column="2" Style="{StaticResource InputStyle}" Margin="0,0,8,0" Tag="Secondary DNS"/>
                    <Button x:Name="AddCustomDnsButton" Grid.Column="3" Content="افزودن + اعمال" Style="{StaticResource ApplyButtonStyle}" Click="AddCustomDnsButton_Click"/>
                </Grid>

                <!--  لیست DNS های کاستوم ذخیره‌شده  -->
                <ItemsControl x:Name="CustomDnsItemsControl" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#12141C" CornerRadius="10" Padding="12,8" Margin="0,0,10,10"
                                    BorderBrush="#2A2E3F" BorderThickness="1" Cursor="Arrow">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F2F6"/>
                                        <TextBlock Text="{Binding Primary}" FontSize="10" Foreground="#8A8F9E"/>
                                    </StackPanel>
                                    <Button Content="اعمال" Margin="14,0,6,0" Padding="10,5" FontSize="11"
                                            Background="#1E293B" Foreground="#F1F2F6" BorderThickness="0" Cursor="Hand"
                                            Click="ApplyCustomDns_Click" Tag="{Binding}"/>
                                    <Button Content="✕" Padding="8,5" FontSize="11"
                                            Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand"
                                            Click="DeleteCustomDns_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  ===================== تاریخچه + دکمه‌های پایین ===================== -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="تاریخچه‌ی تغییرات" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

            <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="12" Padding="4" Cursor="Arrow">
                <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                <Button Content="بازنشانی DNS (Reset)" Style="{StaticResource SecondaryButtonStyle}" Click="Reset_Click" Margin="0,0,10,0"/>
                <Button x:Name="FlushDnsButton" Content="پاک‌سازی DNS Cache" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
