                                <Button Content="بازنشانی" Style="{StaticResource SecondaryButtonStyle}" Click="Reset_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DnsCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Left">
                                    <Path Data="M20 6h-4V5a3 3 0 00-3-3h-2a3 3 0 00-3 3v1H4a1 1 0 000 2h1v11a3 3 0 003 3h8a3 3 0 003-3V8h1a1 1 0 000-2zM10 5a1 1 0 011-1h2a1 1 0 011 1v1h-4zm7 14a1 1 0 01-1 1H8a1 1 0 01-1-1V8h10z"
                                          Fill="{DynamicResource AccentBlue}"/>
