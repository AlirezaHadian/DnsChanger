                                <Viewbox Width="22" Height="22" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M7 6 A8 8 0 1 0 17 6" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
