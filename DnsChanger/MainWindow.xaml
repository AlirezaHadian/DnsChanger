                    <Button x:Name="NavIpInfoButton" Style="{StaticResource SidebarButtonStyle}" Click="NavItem_Click" Tag="IpInfo" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="10,0,0,0" FlowDirection="LeftToRight">
                                <Path Data="M21.41 8.64v-.05a10 10 0 00-18.78 0v.05a9.86 9.86 0 000 6.72v.05a10 10 0 0018.78 0v-.05a9.86 9.86 0 000-6.72zM4.26 14a7.82 7.82 0 010-4h1.86a16.73 16.73 0 000 4zm.82 2h1.4a12.15 12.15 0 001 2.57A8 8 0 015.08 16zm1.4-8h-1.4a8 8 0 012.37-2.57A12.15 12.15 0 006.48 8zM11 19.7A6.34 6.34 0 018.57 16H11zm0-5.7H8.14a14.36 14.36 0 010-4H11zm0-6H8.57A6.34 6.34 0 0111 4.3zm7.92 0h-1.4a12.15 12.15 0 00-1-2.57A8 8 0 0118.92 8zM13 4.3A6.34 6.34 0 0115.43 8H13zm0 15.4V16h2.43A6.34 6.34 0 0113 19.7zm2.86-5.7H13v-4h2.86a14.36 14.36 0 010 4zm.69 4.57a12.15 12.15 0 001-2.57h1.4a8 8 0 01-2.4 2.57zM19.74 14h-1.86a16.16 16.16 0 00.12-2 16.28 16.28 0 00-.12-2h1.86a7.82 7.82 0 010 4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                            <TextBlock Text="اطلاعات IP" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavHistoryButton" Style="{StaticResource SidebarButtonStyle}" Click="NavItem_Click" Tag="History" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="10,0,0,0" FlowDirection="LeftToRight">
                                <Path Data="M12 2a10 10 0 00-6.88 2.77V3a1 1 0 00-2 0v4.5a1 1 0 001 1h4.5a1 1 0 000-2h-2.4A8 8 0 114 12a1 1 0 00-2 0A10 10 0 1012 2zm0 6a1 1 0 00-1 1v3a1 1 0 001 1h2a1 1 0 000-2h-1V9a1 1 0 00-1-1z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                            <TextBlock Text="تاریخچه‌ی تغییرات" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="6,14"/>

                    <Button x:Name="NavSettingsButton" Style="{StaticResource SidebarButtonStyle}" Click="NavItem_Click" Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="10,0,0,0" FlowDirection="LeftToRight">
                                <Path Data="M19.9 12.66a1 1 0 010-1.32l1.28-1.44a1 1 0 00.12-1.17l-2-3.46a1 1 0 00-1.07-.48l-1.88.38a1 1 0 01-1.15-.66l-.61-1.83a1 1 0 00-.95-.68h-4a1 1 0 00-1 .68l-.56 1.83a1 1 0 01-1.15.66L5 4.79a1 1 0 00-1 .48L2 8.73a1 1 0 00.1 1.17l1.27 1.44a1 1 0 010 1.32L2.1 14.1a1 1 0 00-.1 1.17l2 3.46a1 1 0 001.07.48l1.88-.38a1 1 0 011.15.66l.61 1.83a1 1 0 001 .68h4a1 1 0 00.95-.68l.61-1.83a1 1 0 011.15-.66l1.88.38a1 1 0 001.07-.48l2-3.46a1 1 0 00-.12-1.17zM18.41 14l.8.9-1.28 2.22-1.18-.24a3 3 0 00-3.45 2L12.92 20h-2.56L10 18.86a3 3 0 00-3.45-2l-1.18.24-1.3-2.21.8-.9a3 3 0 000-4l-.8-.9 1.28-2.2 1.18.24a3 3 0 003.45-2L10.36 4h2.56l.38 1.14a3 3 0 003.45 2l1.18-.24 1.28 2.22-.8.9a3 3 0 000 3.98zm-6.77-6a4 4 0 104 4 4 4 0 00-4-4zm0 6a2 2 0 112-2 2 2 0 01-2 2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                            <TextBlock Text="تنظیمات" FontSize="13" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--  ===================== محتوای صفحات ===================== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,22,28,22">

                <!--  ///////////////////// صفحه DNS ///////////////////// -->
                <StackPanel x:Name="DnsPagePanel" Visibility="Visible">

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="سرورهای DNS" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="تغییر سریع DNS با یک کلیک" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ResetDnsButton" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7" Click="Reset_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↺" FontSize="13" Margin="8,0,0,0"/>
                                    <TextBlock Text="بازنشانی DNS" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CheckPingButton" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7" Click="CheckPingButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="8,0,0,0" FlowDirection="LeftToRight">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Width="4" Height="6" Canvas.Left="2" Canvas.Top="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Width="4" Height="10" Canvas.Left="10" Canvas.Top="10" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Width="4" Height="14" Canvas.Left="18" Canvas.Top="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RadiusX="1" RadiusY="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="بررسی پینگ همه" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  نوار وضعیت اتصال فعلی  -->
                    <Border Background="{DynamicResource BgCard}" CornerRadius="12" Padding="16,12" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="آداپتور فعال" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="ActiveAdapterText" Text="—" FontSize="14" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DNS فعلی" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="CurrentDnsText" Text="—" FontSize="14" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IP عمومی" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="PublicIpText" Text="—" FontSize="14" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="3" Background="{DynamicResource BgChip}" CornerRadius="20" Padding="10,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8" Fill="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ConnectionStatusText" Text="—" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  افزودن DNS  -->
                    <Border Style="{StaticResource DnsCardStyle}" Padding="16" Margin="0,0,0,18" Cursor="Arrow">
                        <StackPanel>
                            <TextBlock Text="افزودن DNS" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomNameBox" Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,8,0" Tag="نام (مثلا Gaming DNS)"/>
                                <TextBox x:Name="CustomPrimaryBox" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,0,8,0" Tag="Primary DNS"/>
                                <TextBox x:Name="CustomSecondaryBox" Grid.Column="2" Style="{StaticResource InputStyle}" Margin="0,0,8,0" Tag="Secondary DNS"/>
                                <Button x:Name="AddCustomDnsButton" Grid.Column="3" Content="افزودن" Style="{StaticResource ApplyButtonStyle}" Padding="20,8" Click="AddCustomDnsButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  لیست سرورهای DNS — پیش‌فرض‌ها + کاستوم، همه از دیتابیس  -->
                    <TextBlock Text="سرورهای DNS" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                    <ScrollViewer MaxHeight="330" Margin="0,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="CustomDnsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="200" Background="{DynamicResource BgInput}" CornerRadius="12" Padding="14,12" Margin="0,0,12,12"
                                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Arrow">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
                                                                Background="{DynamicResource BgChip}" HorizontalAlignment="Left">
                                                            <Viewbox Width="13" Height="13" FlowDirection="LeftToRight">
                                                                <Path Data="M15 17a1 1 0 101 1 1 1 0 00-1-1zm-6 0H6a1 1 0 000 2h3a1 1 0 000-2zm9 0a1 1 0 101 1 1 1 0 00-1-1zm-3-6a1 1 0 101 1 1 1 0 00-1-1zm-6 0H6a1 1 0 000 2h3a1 1 0 000-2zm9-6a1 1 0 101 1 1 1 0 00-1-1zm0 6a1 1 0 101 1 1 1 0 00-1-1zm4-6a3 3 0 00-3-3H5a3 3 0 00-3 3v2a3 3 0 00.78 2A3 3 0 002 11v2a3 3 0 00.78 2A3 3 0 002 17v2a3 3 0 003 3h14a3 3 0 003-3v-2a3 3 0 00-.78-2 3 3 0 00.78-2v-2a3 3 0 00-.78-2A3 3 0 0022 7zm-2 14a1 1 0 01-1 1H5a1 1 0 01-1-1v-2a1 1 0 011-1h14a1 1 0 011 1zm0-6a1 1 0 01-1 1H5a1 1 0 01-1-1v-2a1 1 0 011-1h14a1 1 0 011 1zm0-6a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1h14a1 1 0 011 1zm-5-2a1 1 0 101 1 1 1 0 00-1-1zM9 5H6a1 1 0 000 2h3a1 1 0 000-2z"
                                                                      Fill="{DynamicResource AccentBlue}"/>
                                                            </Viewbox>
                                                        </Border>
                                                        <Border Grid.Column="1" Background="{DynamicResource BgChip}" CornerRadius="8" Padding="6,3" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding PingText}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                               Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Primary}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding Secondary}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="اعمال" Style="{StaticResource ApplyButtonStyle}" Padding="0,6" FontSize="12"
                                                                Click="ApplyCustomDns_Click" Tag="{Binding}"/>
                                                        <Button Grid.Column="1" Style="{StaticResource DeleteIconButtonStyle}"
                                                                Click="DeleteCustomDns_Click" Tag="{Binding}" Margin="6,0,0,0">
                                                            <Viewbox Width="12" Height="12">
                                                                <Canvas Width="24" Height="24">
                                                                    <Line X1="5" Y1="5" X2="19" Y2="19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                    <Line X1="19" Y1="5" X2="5" Y2="19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                </StackPanel>

                <!--  ///////////////////// صفحه تاریخچه ///////////////////// -->
                <StackPanel x:Name="HistoryPagePanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="تاریخچه‌ی تغییرات" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="فهرست کامل تغییرات DNS که تا الان اعمال شده" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ClearHistoryButton" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7" Click="ClearHistoryButton_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="8,0,0,0" FlowDirection="LeftToRight">
                                    <Path Data="M20 6h-4V5a3 3 0 00-3-3h-2a3 3 0 00-3 3v1H4a1 1 0 000 2h1v11a3 3 0 003 3h8a3 3 0 003-3V8h1a1 1 0 000-2zM10 5a1 1 0 011-1h2a1 1 0 011 1v1h-4zm7 14a1 1 0 01-1 1H8a1 1 0 01-1-1V8h10z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Viewbox>
                                <TextBlock Text="پاک کردن همه" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCard}" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Arrow">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!--  آیکون  -->
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                                Background="{DynamicResource BgChip}" VerticalAlignment="Center">
                                            <Viewbox Width="17" Height="17" FlowDirection="LeftToRight">
                                                <Path Data="M15 17a1 1 0 101 1 1 1 0 00-1-1zm-6 0H6a1 1 0 000 2h3a1 1 0 000-2zm9 0a1 1 0 101 1 1 1 0 00-1-1zm-3-6a1 1 0 101 1 1 1 0 00-1-1zm-6 0H6a1 1 0 000 2h3a1 1 0 000-2zm9-6a1 1 0 101 1 1 1 0 00-1-1zm0 6a1 1 0 101 1 1 1 0 00-1-1zm4-6a3 3 0 00-3-3H5a3 3 0 00-3 3v2a3 3 0 00.78 2A3 3 0 002 11v2a3 3 0 00.78 2A3 3 0 002 17v2a3 3 0 003 3h14a3 3 0 003-3v-2a3 3 0 00-.78-2 3 3 0 00.78-2v-2a3 3 0 00-.78-2A3 3 0 0022 7zm-2 14a1 1 0 01-1 1H5a1 1 0 01-1-1v-2a1 1 0 011-1h14a1 1 0 011 1zm0-6a1 1 0 01-1 1H5a1 1 0 01-1-1v-2a1 1 0 011-1h14a1 1 0 011 1zm0-6a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1h14a1 1 0 011 1zm-5-2a1 1 0 101 1 1 1 0 00-1-1zM9 5H6a1 1 0 000 2h3a1 1 0 000-2z"
                                                      Fill="{DynamicResource AccentBlue}"/>
                                            </Viewbox>
                                        </Border>

                                        <!--  عنوان و جزئیات لاگ  -->
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!--  بج زمان — جدا از اسم  -->
                                        <Border Grid.Column="2" Background="{DynamicResource BgChip}" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='yyyy/MM/dd'}" FontSize="9.5"
                                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!--  ///////////////////// صفحه تست سرعت ///////////////////// -->
                <StackPanel x:Name="SpeedTestPagePanel" Visibility="Collapsed">
                    <TextBlock Text="تست سرعت" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="تست دانلود، آپلود، پینگ و دیتاسنتر" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,14"/>

                    <Border Style="{StaticResource DnsCardStyle}" Cursor="Arrow" Padding="20" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">

                            <!--  دایره‌ی گیج زنده  -->
                            <Grid Width="170" Height="170" Margin="0,0,0,16">
                                <Ellipse Stroke="{DynamicResource BorderColor}" StrokeThickness="9"/>
                                <Ellipse x:Name="SpeedTestProgressRing" Stroke="{DynamicResource AccentGradient}" StrokeThickness="9"
                                         StrokeDashArray="0,1000" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="SpeedTestLiveNumber" Text="0.0" FontSize="30" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Mbps" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="SpeedTestStatusText" Text="آماده" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!--  دکمه‌ی شروع — بزرگ‌تر، بیرون از دایره، با سایه  -->
                            <Button x:Name="StartSpeedTestButton" Style="{StaticResource ApplyButtonStyle}" Padding="30,11"
                                    Click="StartSpeedTestButton_Click">
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#5B8CFF"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="9,0,0,0" FlowDirection="LeftToRight">
                                        <Polygon Points="0,0 0,17 15,8.5" Fill="White"/>
                                    </Viewbox>
                                    <TextBlock Text="شروع تست سرعت" FontSize="13.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--  کارت‌های آمار — هرکدوم پس‌زمینه و حاشیه‌ی مستقل  -->
                    <UniformGrid Columns="5" Margin="0,0,0,12">
                        <Border Background="{DynamicResource BgCard}" CornerRadius="12" BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1" Padding="10" Margin="0,0,10,0" Cursor="Arrow">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="17" Height="17">
                                    <Canvas Width="24" Height="24">
                                        <Line X1="12" Y1="4" X2="12" Y2="17" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                        <Path Data="M6 12 L12 18 L18 12" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
