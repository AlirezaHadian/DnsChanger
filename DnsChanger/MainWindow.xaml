                                <Button x:Name="FlushDnsButton" Content="پاک‌سازی" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="FlushDnsButton_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DnsCardStyle}" Margin="0,0,10,0">
