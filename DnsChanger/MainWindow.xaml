<Window x:Class="DnsChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DnsChanger"
        mc:Ignorable="d"
        Title="Dns Changer" Height="380" Width="275" Background="#FF1C1740"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Images/icon.ico">
    <Window.Resources>
        <!-- HoverButtonStyle for regular buttons -->
        <Style x:Key="HoverButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF555DDC"/>
            <Setter Property="BorderBrush" Value="#FF555DDC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3333AA"/>
                    <Setter Property="BorderBrush" Value="#FF222288"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- HoverButtonStyle for the last button (Reset) -->
        <Style x:Key="DarkerHoverButtonStyle" TargetType="Button" BasedOn="{StaticResource HoverButtonStyle}">
            <Setter Property="Background" Value="#FF242871"/>
            <Setter Property="BorderBrush" Value="#FF242871"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1A1F5A"/>
                    <Setter Property="BorderBrush" Value="#FF111544"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Width="260" HorizontalAlignment="Center" VerticalAlignment="Center" Height="376">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="50"/>
            <RowDefinition Height="19*"/>
            <RowDefinition Height="307*"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DNS Changer" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Left" Margin="60,20,0,0" TextAlignment="Center" FontFamily="Source Sans Pro Black" Foreground="White" Grid.ColumnSpan="3" Width="138"/>

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="60,11,0,0" Height="245" Grid.RowSpan="2" Grid.ColumnSpan="3" Width="138" Grid.Row="1">

            <Border BorderThickness="1" Background="#FF555DDC" CornerRadius="5" Margin="3" Width="120" Height="35">
                <Button x:Name="Shecan" Content="Shecan" Foreground="White" Style="{StaticResource HoverButtonStyle}" Margin="5" Padding="10" Click="Shecan_Click" />
            </Border>
            <Border BorderThickness="1" Background="#FF555DDC" CornerRadius="5" Margin="3" Height="35" Width="120">
                <Button x:Name="Bogzar" Content="Bogzar" Foreground="White" Style="{StaticResource HoverButtonStyle}" Margin="5" Padding="10" Click="Bogzar_Click" Width="100" />
            </Border>
            <Border BorderThickness="1" Background="#FF555DDC" CornerRadius="5" Margin="3" Height="35" Width="120">
                <Button x:Name="_403" Content="403" Foreground="White" Style="{StaticResource HoverButtonStyle}" Margin="5" Padding="10" Click="_403_Click" />
            </Border>
            <Border BorderThickness="1" Background="#FF555DDC" CornerRadius="5" Margin="3" Height="35" Width="120">
                <Button x:Name="HostIran" Content="Host Iran" Foreground="White" Style="{StaticResource HoverButtonStyle}" Margin="5" Padding="10" Click="HostIran_Click" />
            </Border>
            <!--<Border BorderThickness="1" Background="#FF555DDC" CornerRadius="5" Margin="3" Height="35" Width="120">
                <Button x:Name="Custom" Content="Custom DNS" Foreground="White" Style="{StaticResource HoverButtonStyle}" Margin="5" Padding="10" Click="Custom_Click" />
            </Border>-->
            <Border BorderThickness="1" Background="#FF242871" CornerRadius="5" Margin="3" Width="120">
                <Button x:Name="Reset" Content="Reset" Foreground="White" Style="{StaticResource DarkerHoverButtonStyle}" Margin="5" Padding="10" Click="Reset_Click" />
            </Border>

            <Border BorderThickness="1" Background="#FF242871" CornerRadius="5" Margin="3"/>
        </StackPanel>
        <StatusBar Grid.Row="2" Background="White" Grid.ColumnSpan="3" Margin="0,265,0,20">
            <Hyperlink NavigateUri="https://alirezahadian.ir" RequestNavigate="Hyperlink_RequestNavigate">
                Alireza Hadian
            </Hyperlink>
        </StatusBar>

        <Label x:Name="MessageTextBlock" Visibility="Hidden" Content="Button clicked" HorizontalAlignment="Center" Margin="0,204,0,0" Grid.Row="2" VerticalAlignment="Top" Foreground="White" FontSize="14" Grid.ColumnSpan="3" Height="31" Width="178" HorizontalContentAlignment="Center" Background="#FF06B706"/>
    </Grid>
</Window>
